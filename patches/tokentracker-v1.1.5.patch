+        fetchImpl: async () => ({ 'cherry-test-pricing-restart': { input_cost_per_token: rate / 1e6, output_cost_per_token: 1e-6 } }) });
+      const rows = await buildSessionAnalytics({ home });
+      const chat = rows.find(s => s.source === 'cherrystudio' && s.session_kind === 'chat');
+      console.log(JSON.stringify({ cost: chat.cost_usd, revision: pricing.getPricingRevision() }));
+    })().catch(e => { console.error(e.message); process.exitCode = 1; });
