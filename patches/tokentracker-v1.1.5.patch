diff --git a/dashboard/src/lib/cherry-platform-cache.ts b/dashboard/src/lib/cherry-platform-cache.ts
new file mode 100644
index 0000000..ac23793
--- /dev/null
+++ b/dashboard/src/lib/cherry-platform-cache.ts
@@ -0,0 +1,39 @@
+// Platform observations have a separate identity from account totals. Never
+// recover labels from an account response cached by an older patch version.
+export function createCherryPlatformCache() {
+  const memory = new Map<string, any>();
+  const remember = (key: string, value: any) => {
+    memory.delete(key);
+    memory.set(key, value);
+    if (memory.size > 16) memory.delete(memory.keys().next().value!);
+  };
+  return {
+    read(key: string, persistent: boolean) {
+      if (memory.has(key)) return memory.get(key);
+      if (!persistent || typeof window === "undefined") return null;
+      try {
+        const saved = JSON.parse(window.localStorage.getItem(key) || "null");
+        if (saved?.version !== 1 || !Array.isArray(saved?.value?.sources)) return null;
+        remember(key, saved.value);
+        return saved.value;
+      } catch { return null; }
+    },
+    write(key: string, local: any, persistent: boolean) {
+      if (!Array.isArray(local?.sources)) throw new Error("Invalid local platform response");
+      // Keep only model/platform metadata, never usage, credentials or bodies.
+      const value = { sources: local.sources.filter((source: any) => source?.source === "cherrystudio")
+        .map((source: any) => ({ source: "cherrystudio", models: (Array.isArray(source.models) ? source.models : [])
+          .map((model: any) => ({ model: model.model, model_id: model.model_id,
+            platforms: (Array.isArray(model.platforms) ? model.platforms : []).map((platform: any) =>
+              ({ id: platform.id, name: platform.name })),
+          })),
+        })) };
+      remember(key, value);
+      if (persistent && typeof window !== "undefined") {
+        try { window.localStorage.setItem(key, JSON.stringify({ version: 1, value })); }
+        catch { /* keep the complete in-memory snapshot if storage is full */ }
+      }
+      return value;
+    },
+  };
+}
diff --git a/dashboard/src/lib/cherry-platforms.ts b/dashboard/src/lib/cherry-platforms.ts
new file mode 100644
index 0000000..1546e43
--- /dev/null
+++ b/dashboard/src/lib/cherry-platforms.ts
@@ -0,0 +1,51 @@
+import { copy } from "./copy";
+
+export interface CherryPlatform {
+  id: string | null;
+  name: string | null;
+}
+
+export function formatCherryPlatforms(platforms?: CherryPlatform[]) {
+  const unknown = copy("cherry.platform.unknown");
+  const names = [...new Set((Array.isArray(platforms) ? platforms : []).map((platform) =>
+    typeof platform?.name === "string" && platform.name.trim() ? platform.name.trim() : unknown,
+  ))];
+  return names.length ? names.join(" / ") : unknown;
+}
+
+export type CherryPlatformStatus = "fresh" | "cached" | "unavailable";
+
+export function formatCherryPlatformLabel(platforms?: CherryPlatform[], scope?: string, status?: CherryPlatformStatus) {
+  if (scope === "other_device") return copy("cherry.platform.other_device");
+  if (status === "unavailable") return copy(scope === "local" ? "cherry.platform.local_unavailable" : "cherry.platform.unavailable");
+  if (status === "cached") return copy(scope === "local" ? "cherry.platform.local_cached" : "cherry.platform.cached", {
+    names: formatCherryPlatforms(platforms),
+  });
+  if (scope === "local" && !platforms?.length) return copy("cherry.platform.local_missing");
+  return copy(scope === "local" ? "cherry.platform.local_label" : "cherry.platform.label", {
+    names: formatCherryPlatforms(platforms),
+  });
+}
+
+// Account totals stay authoritative. These labels are observations from the
+// computer serving this dashboard, never platform attribution for other PCs.
+export function withLocalCherryPlatforms(account: any, local: any, eligible: boolean, status: CherryPlatformStatus = "fresh") {
+  const key = (value: any) => typeof value === "string" ? value.trim().toLowerCase() : "";
+  const models = new Map<string, CherryPlatform[]>();
+  for (const source of Array.isArray(local?.sources) ? local.sources : []) {
+    if (source?.source !== "cherrystudio") continue;
+    for (const model of Array.isArray(source.models) ? source.models : []) {
+      for (const id of [key(model.model_id), key(model.model)].filter(Boolean)) {
+        models.set(id, Array.isArray(model.platforms) ? model.platforms : []);
+      }
+    }
+  }
+  return { ...account, sources: (Array.isArray(account?.sources) ? account.sources : []).map((source: any) => {
+    if (source?.source !== "cherrystudio") return source;
+    return { ...source, models: (Array.isArray(source.models) ? source.models : []).map((model: any) => ({ ...model,
+      platforms: eligible ? models.get(key(model.model_id)) || models.get(key(model.model)) || [] : [],
+      platforms_scope: eligible ? "local" : "other_device",
+      platforms_status: eligible ? status : "unavailable",
+    })) };
+  }) };
+}
