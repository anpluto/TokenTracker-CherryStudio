+test("Cherry persisted session prices refresh across processes with equal revision counters", (t) => {
+  const f = fixture(t);
+  f.db.prepare("UPDATE ai_usage_record SET model_id='cherry-test-pricing-restart',input_tokens=1000000,no_cache_tokens=1000000,cache_read_tokens=0,cache_write_tokens=0,output_tokens=0,total_tokens=1000000,reasoning_tokens=0 WHERE id='chat-request'").run();
+  const code = `
+    const path = require('node:path');
+    const pricing = require('./src/lib/pricing');
