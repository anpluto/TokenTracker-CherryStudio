new file mode 100644
index 0000000..f69740d
--- /dev/null
+++ b/test/cherrystudio-verification.test.js
@@ -0,0 +1,30 @@
+"use strict";
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+const { spawnSync } = require("node:child_process");
+const { DatabaseSync } = require("node:sqlite");
+
+test("Cherry verification succeeds for an empty ledger without creating a real usage queue", (t) => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "tt-cherry-empty-"));
+  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
+  const dbPath = path.join(root, "empty.sqlite");
+  const db = new DatabaseSync(dbPath);
+  db.exec(`CREATE TABLE ai_usage_record (id TEXT, request_id TEXT, record_kind TEXT, created_at INTEGER,
+    input_tokens INTEGER, output_tokens INTEGER, no_cache_tokens INTEGER, cache_read_tokens INTEGER,
+    cache_write_tokens INTEGER, reasoning_tokens INTEGER, total_tokens INTEGER)`);
+  db.close();
+  const result = spawnSync(process.execPath, [path.join(__dirname, "../scripts/verify-cherrystudio.cjs")], {
+    env: { ...process.env, TOKENTRACKER_CHERRYSTUDIO_DB: dbPath }, encoding: "utf8", timeout: 30000, windowsHide: true,
+  });
+  assert.equal(result.status, 0, result.stderr);
+  const report = JSON.parse(result.stdout);
+  assert.equal(report.verified, true);
+  assert.equal(report.requests, 0);
+  assert.equal(report.repeatSyncBuckets, 0);
+  assert.equal(report.totals.total_tokens, 0);
+  assert.equal(Object.values(report.totals).every((value) => value === 0), true);
+  assert.deepEqual(fs.readdirSync(root), ["empty.sqlite"]);
+});
