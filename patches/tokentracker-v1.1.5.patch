+++ b/test/cherrystudio.test.js
@@ -0,0 +1,376 @@
+"use strict";
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+const { execFileSync } = require("node:child_process");
+const { DatabaseSync } = require("node:sqlite");
+const {
+  resolveCherryStudioDbPath, normalizeCherryStudioUsage, readCherryStudioUsageRows,
+  parseCherryStudioIncremental, scanCherryStudioSessions,
+  createCherryStudioPlatformLookup,
+} = require("../src/lib/cherrystudio");
+const { computeRowCost, getModelPricing } = require("../src/lib/pricing");
+const { buildSessionAnalytics, listSessionsForBrowser, summarizeSessions, sessionsToCsv } = require("../src/lib/session-analytics");
+
+const SECRET = "PROMPT-REPLY-CREDENTIAL-MUST-NOT-BE-READ";
+const AT = Date.UTC(2026, 9, 8, 5);
+
+function fixture(t, { wal = false } = {}) {
+  const home = fs.mkdtempSync(path.join(os.tmpdir(), "tt-cherry-"));
+  const dbPath = resolveCherryStudioDbPath({ home, env: {} });
+  fs.mkdirSync(path.dirname(dbPath), { recursive: true });
+  const db = new DatabaseSync(dbPath);
+  if (wal) db.exec("PRAGMA journal_mode=WAL; PRAGMA wal_autocheckpoint=0;");
+  db.exec(`
+    CREATE TABLE ai_usage_record (id TEXT, request_id TEXT, record_kind TEXT,
+      request_count INTEGER, message_kind TEXT, message_id TEXT, provider_id TEXT, provider_name TEXT, model_id TEXT,
+      model_name TEXT, input_tokens INTEGER, output_tokens INTEGER, total_tokens INTEGER,
+      reasoning_tokens INTEGER, no_cache_tokens INTEGER, cache_read_tokens INTEGER,
+      cache_write_tokens INTEGER, created_at INTEGER, api_key_label TEXT);
+    CREATE TABLE topic (id TEXT, name TEXT);
+    CREATE TABLE message (id TEXT, topic_id TEXT, data TEXT, searchable_text TEXT, message_snapshot TEXT);
+    CREATE TABLE agent_session (id TEXT, name TEXT);
+    CREATE TABLE agent_session_message (id TEXT, session_id TEXT, data TEXT);
+  `);
+  db.prepare("INSERT INTO topic VALUES (?,?)").run("topic-one", "Chat title");
+  db.prepare("INSERT INTO message VALUES (?,?,?,?,?)").run("chat-msg", "topic-one", SECRET, SECRET, SECRET);
+  db.prepare("INSERT INTO agent_session VALUES (?,?)").run("agent-one", "Agent title");
+  db.prepare("INSERT INTO agent_session_message VALUES (?,?,?)").run("agent-msg", "agent-one", SECRET);
+  const insert = db.prepare(`INSERT INTO ai_usage_record VALUES (${Array(19).fill("?").join(",")})`);
+  const add = (id, overrides = {}) => {
+    const row = { id, request_id: id, record_kind: "invocation", request_count: 1,
+      message_kind: null, message_id: null, provider_id: "platform-one-private-id", provider_name: "Platform One",
+      model_id: "gpt-4o", model_name: null,
+      input_tokens: 100, output_tokens: 20, total_tokens: 120, reasoning_tokens: 5,
+      no_cache_tokens: 65, cache_read_tokens: 30, cache_write_tokens: 5,
+      created_at: AT, api_key_label: SECRET, ...overrides };
+    insert.run(...Object.values(row));
+  };
+  add("chat-request", { message_kind: "chat", message_id: "chat-msg" });
+  add("agent-request", { message_kind: "agent-session", message_id: "agent-msg", created_at: AT + 1000 });
+  add("unlinked-request", { model_id: "unknown-price-model", created_at: AT + 2000 });
+  add("legacy", { record_kind: "legacy-aggregate" });
+  t.after(() => { try { db.close(); } catch {} fs.rmSync(home, { recursive: true, force: true }); });
+  return { home, dbPath, db, add, queuePath: path.join(home, ".tokentracker", "tracker", "queue.jsonl") };
+}
+
+test("Cherry normalization excludes caches and never double-counts reasoning", () => {
+  const usage = normalizeCherryStudioUsage({ created_at: AT, model_id: "gpt-4o",
+    input_tokens: 100, output_tokens: 20, total_tokens: 120, cache_read_tokens: 30,
+    cache_write_tokens: 5, reasoning_tokens: 5 });
+  assert.equal(usage.input_tokens, 65);
+  assert.equal(usage.cached_input_tokens, 30);
+  assert.equal(usage.cache_creation_input_tokens, 5);
+  assert.equal(usage.output_tokens, 20);
+  assert.equal(usage.reasoning_output_tokens, 5);
+  assert.equal(usage.total_tokens, 120);
+  const pricing = getModelPricing(usage.model);
+  assert.ok(pricing.input > 0);
+  assert.equal(computeRowCost(usage), (65*pricing.input+30*(pricing.cache_read || 0)+5*(pricing.cache_write || 0)+20*pricing.output)/1e6);
+  assert.equal(normalizeCherryStudioUsage({created_at: 1e40}), null);
+});
+
+test("Cherry reads only projected metadata, joins chat/Agent sessions and keeps unlinked usage", async (t) => {
+  const f = fixture(t);
+  const statements = [];
+  class TrackedDb extends DatabaseSync {
+    prepare(sql) { statements.push(sql); return super.prepare(sql); }
+  }
+  const sqliteOptions = {
+    execFile: (_exe, _args, _opts, cb) => cb(Object.assign(new Error("CLI unavailable"), { code: "ENOENT" })),
+    requireFn: () => ({ DatabaseSync: TrackedDb }),
+  };
+  const rows = await readCherryStudioUsageRows(f.dbPath, { sessions: true, sqliteOptions });
+  assert.equal(rows.length, 3);
+  assert.ok(!JSON.stringify(rows).includes(SECRET));
+  assert.ok(statements.filter((sql) => sql.startsWith("SELECT")).every((sql) => !/\b(data|searchable_text|message_snapshot|api_key_label)\b/.test(sql)));
+  const sessions = await scanCherryStudioSessions(f.dbPath);
+  assert.deepEqual(sessions.map((s) => s.session_kind).sort(), ["agent", "chat", "unlinked"]);
+  assert.equal(sessions.reduce((sum,s) => sum+s.total_tokens, 0), 360);
+  assert.ok(sessions.find((s) => s.session_kind === "unlinked").cost_is_partial);
+  assert.equal(listSessionsForBrowser(sessions).sessions.find((s) => s.title === "Agent title").resume_command, null);
+  const exported = JSON.stringify(summarizeSessions(sessions)) + sessionsToCsv(summarizeSessions(sessions).sessions);
+  for (const privateValue of [SECRET, "Chat title", "Agent title", "chat:topic-one", "agent:agent-one", "platform-one-private-id", "Platform One"]) assert.ok(!exported.includes(privateValue));
+  assert.ok(!exported.includes('"platforms"'));
+});
+
+test("Cherry keeps platform metadata local and selects the latest name per platform/model/session", async (t) => {
+  const f = fixture(t);
+  f.add("renamed", { provider_name: "Renamed Platform", message_kind: "chat", message_id: "chat-msg", created_at: AT + 3000 });
+  f.add("platform-two", { provider_id: "platform-two-private-id", provider_name: "Platform Two", message_kind: "chat", message_id: "chat-msg", created_at: AT + 4000 });
+  f.add("named-only", { provider_id: null, provider_name: "Named Platform", message_kind: "chat", message_id: "chat-msg", created_at: AT + 5000 });
+  f.add("unknown-platform", { provider_id: null, provider_name: null, message_kind: "chat", message_id: "chat-msg", created_at: AT + 6000 });
+  const rows = await buildSessionAnalytics({ home: f.home, force: true });
+  const cached = await buildSessionAnalytics({ home: f.home });
+  const chat = listSessionsForBrowser(cached).sessions.find((row) => row.session_kind === "chat");
+  assert.deepEqual(chat.platforms.map((p) => p.name).sort(), [null, "Named Platform", "Platform Two", "Renamed Platform"].sort());
+  assert.deepEqual(chat.model_usage[0].platforms, chat.platforms);
+  assert.equal(chat.platforms.filter((p) => p.id === "platform-one-private-id").length, 1);
+  assert.equal(listSessionsForBrowser(rows).sessions.find((row) => row.session_kind === "agent").platforms[0].name, "Platform One");
+  const cursors = {};
+  await parseCherryStudioIncremental({ ...f, cursors });
+  const metrics = Object.values(cursors.cherrystudio.buckets);
+  assert.equal(metrics.reduce((sum, row) => sum + row.total_tokens, 0), rows.reduce((sum, row) => sum + row.total_tokens, 0));
+  const exported = JSON.stringify(summarizeSessions(cached));
+  const queue = fs.readFileSync(f.queuePath, "utf8") + JSON.stringify(cursors);
