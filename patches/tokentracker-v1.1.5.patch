index 0000000..f23b612
--- /dev/null
+++ b/src/lib/cherrystudio.js
@@ -0,0 +1,316 @@
+"use strict";
+
+// Cherry Studio 2.x invocation ledger. Never select message bodies, snapshots,
+// searchable text, provider credentials, or raw usage JSON. Session and API
+// platform names/ids are local-only, never in the usage queue or its cursors.
+const fs = require("node:fs");
+const fsp = require("node:fs/promises");
+const os = require("node:os");
+const path = require("node:path");
+const crypto = require("node:crypto");
+const { readSqliteJsonRowsAsync } = require("./sqlite-reader");
+const { toUtcHalfHourStart } = require("./rollout");
+const { getModelPricing, computeRowCost, ZERO_PRICING, OPENAI_LONG_CONTEXT_INPUT_THRESHOLD } = require("./pricing");
+
+const SOURCE = "cherrystudio";
+const CURSOR_VERSION = 2;
+const TOKEN_FIELDS = ["input_tokens", "cached_input_tokens", "cache_creation_input_tokens",
+  "output_tokens", "reasoning_output_tokens", "total_tokens"];
+const LONG_FIELDS = ["input_tokens", "cached_input_tokens", "cache_creation_input_tokens", "output_tokens"];
+const count = (value) => Number.isFinite(Number(value)) && Number(value) > 0 ? Math.trunc(Number(value)) : 0;
+const hash = (value) => crypto.createHash("sha256").update(value).digest("hex").slice(0, 24);
+
+function resolveCherryStudioDbPath(options = {}) {
+  const { env = process.env, home = env.HOME || env.USERPROFILE || os.homedir(), platform = process.platform } = options;
+  if (env.TOKENTRACKER_CHERRYSTUDIO_DB) return path.resolve(env.TOKENTRACKER_CHERRYSTUDIO_DB);
+  // An explicit test/alternate home must not scan the current user's app data.
+  const allowRoot = (root) => root && (!Object.hasOwn(options, "home")
+    || path.resolve(root).toLowerCase().startsWith(path.resolve(home).toLowerCase() + path.sep));
+  const root = platform === "win32"
+    ? allowRoot(env.APPDATA) && env.APPDATA || path.join(home, "AppData", "Roaming")
+    : platform === "darwin" ? path.join(home, "Library", "Application Support")
+      : allowRoot(env.XDG_CONFIG_HOME) && env.XDG_CONFIG_HOME || path.join(home, ".config");
+  return path.join(root, "CherryStudio", "Data", "cherrystudio.sqlite");
+}
+
+function cherryStudioFingerprint(dbPath) {
+  return [dbPath, `${dbPath}-wal`].map((file) => {
+    try {
+      const stat = fs.statSync(file, { bigint: true });
+      return `${stat.size}:${stat.mtimeNs}:${stat.ino}`;
+    } catch (error) {
+      if (error.code === "ENOENT") return "absent";
+      throw error;
+    }
+  }).join("|");
+}
+
+async function readCherryStudioUsageRows(dbPath, { sessions = false, sqliteOptions = {} } = {}) {
+  if (!fs.existsSync(dbPath)) throw new Error("Cherry Studio usage database is unavailable");
+  const identity = fs.statSync(dbPath, { bigint: true });
+  const assertAvailable = () => {
+    let stat;
+    try { stat = fs.statSync(dbPath, { bigint: true }); }
+    catch { throw new Error("Cherry Studio usage database is unavailable"); }
+    if (stat.ino !== identity.ino || stat.dev !== identity.dev) {
+      throw new Error("Cherry Studio usage database changed during the read; retry sync");
+    }
+  };
+  const read = async (sql) => {
+    assertAvailable();
+    const rows = await readSqliteJsonRowsAsync(dbPath, sql, {
+      ...sqliteOptions, readOnly: true, throwOnReadFailure: true, label: "Cherry Studio",
+    });
+    // The shared reader returns [] when a file vanishes, even in strict mode.
+    // Do not interpret that as an empty ledger and erase prior bucket snapshots.
+    assertAvailable();
+    return rows;
+  };
+  const columns = new Set((await read("PRAGMA table_info(ai_usage_record)")).map((row) => row.name));
+  for (const required of ["id", "request_id", "record_kind", "created_at"]) {
+    if (!columns.has(required)) throw new Error(`Unsupported Cherry Studio ledger schema: missing ${required}`);
+  }
+  if (!["input_tokens", "output_tokens", "total_tokens"].some((name) => columns.has(name))) {
+    throw new Error("Unsupported Cherry Studio ledger schema: missing token counters");
+  }
+  const fields = ["id", "request_id", "record_kind", "request_count", "message_kind", "message_id",
+    "provider_id", "provider_name", "model_id", "model_name", "input_tokens", "output_tokens", "total_tokens", "reasoning_tokens",
+    "no_cache_tokens", "cache_read_tokens", "cache_write_tokens", "created_at"];
+  const select = fields.map((name) => columns.has(name) ? `u.${name}` : `NULL AS ${name}`);
+  let joins = "";
+  if (sessions && columns.has("message_kind") && columns.has("message_id")) {
+    const tableColumns = {};
+    for (const table of ["message", "topic", "agent_session_message", "agent_session"]) {
+      tableColumns[table] = new Set((await read(`PRAGMA table_info(${table})`)).map((row) => row.name));
+    }
+    const has = (table, names) => names.every((name) => tableColumns[table].has(name));
+    const chat = has("message", ["id", "topic_id"]) && has("topic", ["id", "name"]);
+    const agent = has("agent_session_message", ["id", "session_id"]) && has("agent_session", ["id", "name"]);
+    if (chat) joins += " LEFT JOIN message m ON u.message_kind='chat' AND m.id=u.message_id LEFT JOIN topic t ON t.id=m.topic_id";
+    if (agent) joins += " LEFT JOIN agent_session_message am ON u.message_kind='agent-session' AND am.id=u.message_id LEFT JOIN agent_session a ON a.id=am.session_id";
+    select.push(`CASE ${chat ? "WHEN t.id IS NOT NULL THEN 'chat:' || t.id " : ""}${agent ? "WHEN a.id IS NOT NULL THEN 'agent:' || a.id " : ""}ELSE NULL END AS session_key`);
+    select.push(`CASE ${chat ? "WHEN t.id IS NOT NULL THEN t.name " : ""}${agent ? "WHEN a.id IS NOT NULL THEN a.name " : ""}ELSE NULL END AS session_title`);
+    // No joins are possible on an older schema: do not generate an empty CASE.
+    if (!chat && !agent) select.splice(-2, 2, "NULL AS session_key", "NULL AS session_title");
+  } else if (sessions) select.push("NULL AS session_key", "NULL AS session_title");
+  return read(`SELECT ${select.join(", ")} FROM ai_usage_record u${joins} WHERE u.record_kind='invocation' ORDER BY u.created_at,u.id`);
+}
+
+function normalizeCherryStudioUsage(row) {
+  const timestamp = Number(row.created_at);
+  if (!Number.isFinite(timestamp) || timestamp <= 0) return null;
+  const date = new Date(timestamp < 1e12 ? timestamp * 1000 : timestamp);
+  if (!Number.isFinite(date.getTime())) return null;
+  const iso = date.toISOString();
+  const cacheRead = count(row.cache_read_tokens);
+  const cacheWrite = count(row.cache_write_tokens);
+  // AI SDK input totals contain cache reads/writes. no_cache_tokens is the
+  // explicit non-cached remainder; prefer it over inferring the subtraction.
+  const input = row.no_cache_tokens != null ? count(row.no_cache_tokens)
+    : Math.max(0, count(row.input_tokens) - cacheRead - cacheWrite);
+  const output = count(row.output_tokens);
+  // AI SDK output total already contains reasoning. It is informational only.
+  const reasoning = Math.min(output, count(row.reasoning_tokens));
+  const sum = input + cacheRead + cacheWrite + output;
+  const total = row.total_tokens != null ? count(row.total_tokens) : sum;
+  const model = String(row.model_id || row.model_name || "cherrystudio-unknown").trim() || "cherrystudio-unknown";
+  const result = {
+    source: SOURCE, model, hour_start: toUtcHalfHourStart(iso), timestamp: iso,
+    input_tokens: input, cached_input_tokens: cacheRead, cache_creation_input_tokens: cacheWrite,
+    output_tokens: output, reasoning_output_tokens: reasoning, total_tokens: total,
+    billable_total_tokens: total, conversation_count: 1,
+    usage_is_incomplete: total !== sum || row.output_tokens == null
+      || (row.input_tokens == null && row.no_cache_tokens == null),
+  };
+  const pricing = getModelPricing(model, { source: SOURCE });
+  result.cost_is_partial = total > 0 && (result.usage_is_incomplete
+    || pricing === ZERO_PRICING);
+  if (input + cacheRead + cacheWrite > OPENAI_LONG_CONTEXT_INPUT_THRESHOLD) {
+    for (const field of LONG_FIELDS) result[`long_context_${field}`] = result[field];
+  }
+  return result;
+}
+
+function normalizedInvocations(rows) {
+  const seen = new Set();
+  const result = [];
+  for (const row of rows) {
+    if (row.record_kind !== "invocation") continue;
+    const id = String(row.request_id || row.id || "");
+    if (!id || seen.has(id)) continue;
+    const usage = normalizeCherryStudioUsage(row);
+    if (!usage) continue;
+    seen.add(id);
+    result.push({ row, usage });
+  }
+  return result;
+}
+
+function sumUsage(target, usage) {
+  for (const field of [...TOKEN_FIELDS, "billable_total_tokens", "conversation_count",
+    ...LONG_FIELDS.map((field) => `long_context_${field}`)]) target[field] = count(target[field]) + count(usage[field]);
+  target.usage_is_incomplete = Boolean(target.usage_is_incomplete || usage.usage_is_incomplete);
+  target.cost_is_partial = Boolean(target.cost_is_partial || usage.cost_is_partial);
+}
+
+const platformText = (value) => typeof value === "string" ? value.replace(/[\x00-\x1f\x7f]/g, "").trim() || null : null;
+function addPlatform(map, value) {
+  const id = platformText(value?.id);
+  const name = platformText(value?.name);
+  const key = id ? `id:${id}` : name ? `name:${name}` : "unknown";
+  map.set(key, { id, name });
+}
+function platformList(map) {
+  return [...map.values()].sort((a, b) => (a.name || "").localeCompare(b.name || "")
+    || (a.id || "").localeCompare(b.id || ""));
+}
+function mergeCherryPlatforms(...lists) {
+  const map = new Map();
+  for (const list of lists) for (const value of Array.isArray(list) ? list : []) addPlatform(map, value);
+  return platformList(map);
+}
+
+// A handler-local metadata cache, separate from the numeric usage queue.
+// Cache raw observations so every requested date/timezone gets its own names.
+function createCherryStudioPlatformLookup() {
+  const snapshots = new Map();
+  async function eventsFor(dbPath) {
+    let snapshot = snapshots.get(dbPath);
+    let fingerprint;
+    try { fingerprint = cherryStudioFingerprint(dbPath); }
+    catch { return { events: snapshot?.events || [], status: snapshot?.fingerprint ? "cached" : "unavailable" }; }
+    if (snapshot?.fingerprint === fingerprint) return { events: snapshot.events, status: "fresh" };
+    if (snapshot?.pending) return snapshot.pending;
+    if (!snapshot) {
+      snapshot = { events: [] };
+      snapshots.set(dbPath, snapshot);
+    }
+    const current = snapshot;
+    current.pending = (async () => {
+      try {
+        const entries = normalizedInvocations(await readCherryStudioUsageRows(dbPath));
+        current.events = entries.map(({ row, usage }) => ({
+          model: usage.model, hour_start: usage.hour_start,
+          id: platformText(row.provider_id), name: platformText(row.provider_name),
+        }));
+        current.fingerprint = fingerprint;
+        return { events: current.events, status: "fresh" };
+      } catch { /* retain the last complete platform observations */ }
+      return { events: current.events, status: current.fingerprint ? "cached" : "unavailable" };
+    })();
+    try { return await current.pending; }
+    finally { current.pending = null; }
+  }
+  return async function lookup({ dbPath = resolveCherryStudioDbPath(), from = "", to = "", dayKey = (row) => row.hour_start.slice(0, 10) } = {}) {
+    const byModel = new Map();
+    const snapshot = await eventsFor(dbPath);
+    for (const event of snapshot.events) {
+      const day = dayKey(event);
+      if ((from && day < from) || (to && day > to)) continue;
+      let platforms = byModel.get(event.model);
+      if (!platforms) byModel.set(event.model, platforms = new Map());
+      addPlatform(platforms, event);
+    }
+    return { byModel: new Map([...byModel].map(([model, platforms]) => [model, platformList(platforms)])), status: snapshot.status };
+  };
+}
+
+async function parseCherryStudioIncremental({ dbPath = resolveCherryStudioDbPath(), cursors, queuePath, sqliteOptions } = {}) {
+  const fingerprint = cherryStudioFingerprint(dbPath);
+  const prior = cursors.cherrystudio || {};
+  if (prior.version === CURSOR_VERSION && prior.fingerprint === fingerprint) return { recordsProcessed: 0, eventsAggregated: 0, bucketsQueued: 0 };
+  // Complete read first. Failed reads do not advance cursors or publish zeros.
+  const rows = await readCherryStudioUsageRows(dbPath, { sqliteOptions });
+  const entries = normalizedInvocations(rows);
+  const buckets = {};
+  for (const { usage } of entries) {
+    const key = `${usage.model}\0${usage.hour_start}`;
+    const bucket = buckets[key] ||= { source: SOURCE, model: usage.model, hour_start: usage.hour_start };
+    sumUsage(bucket, usage);
+  }
+  const changed = [];
+  for (const key of new Set([...Object.keys(prior.buckets || {}), ...Object.keys(buckets)])) {
+    const before = prior.buckets?.[key];
+    const after = buckets[key];
+    if (JSON.stringify(before) === JSON.stringify(after)) continue;
+    if (after) changed.push(after);
+    else {
+      const tombstone = { ...before };
+      for (const field of Object.keys(tombstone)) if (typeof tombstone[field] === "number") tombstone[field] = 0;
+      tombstone.cost_is_partial = false;
+      tombstone.usage_is_incomplete = false;
+      changed.push(tombstone);
+    }
+  }
+  if (changed.length) {
+    await fsp.mkdir(path.dirname(queuePath), { recursive: true });
+    await fsp.appendFile(queuePath, changed.map((row) => JSON.stringify(row)).join("\n") + "\n", { mode: 0o600 });
+  }
+  // Save the fingerprint observed BEFORE querying. A concurrent writer will
+  // change it and force another full scan; newer WAL rows cannot be missed.
+  cursors.cherrystudio = { version: CURSOR_VERSION, fingerprint, buckets, records: entries.length, updatedAt: new Date().toISOString() };
+  return { recordsProcessed: rows.length, eventsAggregated: entries.length, bucketsQueued: changed.length };
+}
+
+async function scanCherryStudioSessions(dbPath, { sqliteOptions } = {}) {
+  const entries = normalizedInvocations(await readCherryStudioUsageRows(dbPath, { sessions: true, sqliteOptions }));
+  const sessions = new Map();
+  for (const { row, usage } of entries) {
+    // Unlinked usage stays visible, grouped by calendar day rather than being
+    // attributed to an invented conversation. Every invocation belongs once.
+    const key = row.session_key || `unlinked:${usage.timestamp.slice(0, 10)}`;
+    let session = sessions.get(key);
+    if (!session) {
+      const kind = key.startsWith("chat:") ? "chat" : key.startsWith("agent:") ? "agent" : "unlinked";
+      const title = typeof row.session_title === "string" ? row.session_title.replace(/\s+/g, " ").trim().slice(0, 120) : null;
+      session = {
+        session_hash: hash(`${SOURCE}\0${key}`), session_id: row.session_key || null,
+        title: title || null, source: SOURCE, session_kind: kind,
+        project_key: "Cherry Studio", project_ref: null, model: usage.model,
+        started_at: usage.timestamp, ended_at: usage.timestamp, duration_ms: 0,
+        turns: 0, edit_turns: 0, retry_turns: 0, subagent_calls: 0,
+        tokens: {}, total_tokens: 0, cost_usd: 0, model_usage: [],
+        cost_source: "model_pricing", usage_precision: "reported", cost_is_partial: false,
+        usage_is_incomplete: false, usage_events: 0, model_calls: 0,
+        provenance: { source: "local-usage-ledger", confidence: "observed", content_retained: false },
+        _models: new Map(), _messageIds: new Set(), _platforms: new Map(),
+      };
+      sessions.set(key, session);
+    }
+    sumUsage(session.tokens, usage);
+    let modelUsage = session._models.get(usage.model);
+    if (!modelUsage) session._models.set(usage.model, modelUsage = { model: usage.model, _platforms: new Map() });
+    const platform = { id: row.provider_id, name: row.provider_name };
+    addPlatform(session._platforms, platform);
+    addPlatform(modelUsage._platforms, platform);
+    sumUsage(modelUsage, usage);
+    // Price each request so time windows and long-context tiers stay correct.
+    modelUsage.cost_usd = (modelUsage.cost_usd || 0) + computeRowCost(usage);
+    session.started_at = session.started_at < usage.timestamp ? session.started_at : usage.timestamp;
+    session.ended_at = session.ended_at > usage.timestamp ? session.ended_at : usage.timestamp;
+    session._messageIds.add(String(row.message_id || row.request_id || row.id));
+    session.usage_events += 1;
+    session.model_calls += 1;
+    session.cost_is_partial ||= usage.cost_is_partial;
+    session.usage_is_incomplete ||= usage.usage_is_incomplete;
+  }
+  return [...sessions.values()].map((session) => {
+    session.platforms = platformList(session._platforms);
+    session.model_usage = [...session._models.values()].map(({ _platforms, ...usage }) => ({
+      ...usage, platforms: platformList(_platforms),
+    }));
+    session.model = session.model_usage.length > 1 ? "mixed" : session.model_usage[0].model;
+    session.turns = session._messageIds.size;
+    session.total_tokens = session.tokens.total_tokens;
+    session.cost_usd = session.model_usage.reduce((sum, row) => sum + row.cost_usd, 0);
+    session.usage_precision = session.usage_is_incomplete ? "reported_incomplete" : "reported";
+    delete session._models;
+    delete session._messageIds;
+    delete session._platforms;
+    return session;
+  });
+}
+
+module.exports = { SOURCE, resolveCherryStudioDbPath, cherryStudioFingerprint,
+  readCherryStudioUsageRows, normalizeCherryStudioUsage, parseCherryStudioIncremental, scanCherryStudioSessions,
+  mergeCherryPlatforms, createCherryStudioPlatformLookup };
