+test("Cherry model API adds only local platform metadata with matching timezone and unchanged numeric totals", async (t) => {
+  const f = fixture(t);
+  f.add("late", { provider_id: "late-platform", provider_name: "Next Local Day", created_at: Date.UTC(2026, 9, 8, 17) });
+  await parseCherryStudioIncremental({ ...f, cursors: {} });
+  const { createLocalApiHandler } = require("../src/lib/local-api");
+  const handler = createLocalApiHandler({ queuePath: f.queuePath, cherryStudioDbPath: f.dbPath });
+  const call = async (date, tz, usingHandler = handler) => {
+    let body;
+    const url = new URL(`http://localhost/functions/tokentracker-usage-model-breakdown?from=${date}&to=${date}&tz=${tz}`);
+    const res = { setHeader() {}, writeHead() {}, end(value) { body = JSON.parse(value); } };
+    await usingHandler({ method: "GET", headers: { host: "localhost" } }, res, url);
+    return body.sources.find((source) => source.source === "cherrystudio");
+  };
+  const today = await call("2026-10-08", "Asia/Shanghai");
+  assert.equal(today.totals.total_tokens, 360);
+  assert.deepEqual(today.models.find((row) => row.model === "gpt-4o").platforms, [{ id: "platform-one-private-id", name: "Platform One" }]);
+  const tomorrow = await call("2026-10-09", "Asia/Shanghai");
+  assert.equal(tomorrow.totals.total_tokens, 120);
+  assert.equal(tomorrow.models[0].platforms[0].name, "Next Local Day");
+  const utc = await call("2026-10-08", "UTC");
+  assert.equal(utc.totals.total_tokens, 480);
+  assert.equal(utc.models.find((row) => row.model === "gpt-4o").platforms.length, 2);
+  const numeric = Object.values((await parseForComparison(f)).cherrystudio.buckets).reduce((sum, row) => sum + computeRowCost(row), 0);
+  assert.equal(Number(utc.totals.total_cost_usd), Number(numeric.toFixed(6)));
+  assert.ok(!JSON.stringify(utc).includes(SECRET));
+  assert.equal(utc.models[0].platforms_status, "fresh");
+  f.db.close(); fs.renameSync(f.dbPath, `${f.dbPath}.away`);
+  const unavailableDb = await call("2026-10-08", "UTC");
+  assert.equal(unavailableDb.models[0].platforms_status, "cached");
+  assert.equal(unavailableDb.totals.total_tokens, utc.totals.total_tokens);
+  const restarted = createLocalApiHandler({ queuePath: f.queuePath, cherryStudioDbPath: f.dbPath });
+  const afterRestart = await call("2026-10-08", "UTC", restarted);
+  assert.equal(afterRestart.models[0].platforms_status, "unavailable");
+  assert.equal(afterRestart.totals.total_tokens, utc.totals.total_tokens);
+});
